# Environment variables for api-service
# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@postgres:5432/crm

# Notification service base URL (in-Docker address)
NOTIFICATION_SERVICE_URL=http://notification-service:5000

# JWT signing secret (change in production!)
JWT_SECRET=change-me

# Seed admin credentials (used by scripts/seed.ts on startup)
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=admin123